# Tokens for HTTP authentication (comma-separated).
# Leave empty to disable auth (local testing only).
CARTOGRAPHER_TOKENS=

# Directory with every secret file, found by KB name: default.age (or <kb>.age)
# is the SOPS age key, default.ssh the git SSH key, default.token the HTTPS git
# token. Empty keeps it at <data>/credentials.
CARTOGRAPHER_CREDENTIALS_DIR=

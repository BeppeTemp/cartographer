{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BeppeTemp/cartographer/docs/schemas/hooks/secret_resolver.json",
  "title": "Hook point secret_resolver, protocol version 1",
  "description": "Asked for the value of a secret_refs item NAME=hook:<plugin>/<name>#<key>. An answer without value is a failure unless it denies. Unknown fields are ignored in both directions (additive evolution).",
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "version",
        "hook",
        "request_id",
        "time",
        "kb",
        "concept_id",
        "name",
        "key",
        "principal"
      ],
      "properties": {
        "version": {
          "const": 1,
          "description": "Hook protocol version; a response with another version is a failure."
        },
        "hook": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/[a-z0-9][a-z0-9-]*$",
          "description": "The hook's <plugin>/<name>."
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "Also in the Cartographer-Request-Id header."
        },
        "time": {
          "type": "string",
          "format": "date-time",
          "description": "Server clock, UTC, RFC 3339."
        },
        "kb": {
          "type": "string"
        },
        "concept_id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "key": {
          "type": "string",
          "maxLength": 512
        },
        "principal": {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "",
                "human",
                "client",
                "surveyor"
              ]
            },
            "via": {
              "type": "string"
            },
            "groups": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": 1,
          "description": "Hook protocol version; a response with another version is a failure."
        },
        "value": {
          "type": "string"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Cache the value for this long; capped at 300 and the hook's cache_ttl. Absent: no caching."
        },
        "decision": {
          "type": "string",
          "description": "Only \"deny\" denies; any other value, \"allow\" included, is no opinion."
        },
        "reason": {
          "type": "string",
          "description": "Shown to the caller in the coded denial, cut to 200 printable characters."
        }
      }
    }
  }
}

{
  "identity": "metrics-viewer",
  "groups": [
    {
      "key": "service/api",
      "title": "API service",
      "alert_labels": {"service": "api"},
      "signals": [
        {
          "name": "error-ratio",
          "query": "(sum(rate(http_requests_total{service=\"api\",code=~\"5..\"}[1h])) / sum(rate(http_requests_total{service=\"api\"}[1h]))) / clamp_min(sli:api_error_ratio:rate28d, 0.0001)",
          "bands": [{"below": 1.5, "verdict": "ok"}, {"below": 3, "verdict": "watch"}, {"verdict": "bad"}]
        }
      ]
    },
    {
      "key": "storage/data",
      "title": "Data volumes",
      "signals": [
        {
          "name": "days-to-full",
          "query": "min(node_filesystem_avail_bytes{mountpoint=\"/data\"} / clamp_min(-deriv(node_filesystem_avail_bytes{mountpoint=\"/data\"}[7d]), 0.000001)) / 86400",
          "bands": [{"below": 14, "verdict": "bad"}, {"below": 60, "verdict": "watch"}, {"verdict": "ok"}]
        }
      ]
    }
  ]
}
